# Local development works without a .env file. To override defaults, copy this
# file to .env (which is never committed) and edit it.
DJANGO_SECRET_KEY=change-me

# Uncomment to use PostgreSQL instead of SQLite:
# DATABASE_URL=postgres://langton:langton@localhost:5432/langton

# Production only (PythonAnywhere):
# DJANGO_ALLOWED_HOSTS=your-username.pythonanywhere.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-username.pythonanywhere.com
